{
  "name": "@orvelt/business",
  "version": "0.1.8",
  "description": "Orvelt Business REST SDK and frontend-only opinion iframe SDK.",
  "license": "Apache-2.0",
  "author": "Orvelt Inc.",
  "trustedDependencies": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orveltinc/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/orveltinc/typescript-sdk/issues"
  },
  "homepage": "https://github.com/orveltinc/typescript-sdk#readme",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "bun": ">=1.3.3"
  },
  "sideEffects": false,
  "unpkg": "./dist/opinion-embed.js",
  "jsdelivr": "./dist/opinion-embed.js",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./skills/*": "./skills/*",
    "./openapi.json": "./openapi.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "skills",
    "openapi.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun run generate && bun run typecheck && bun run test && rm -rf dist && tsc --project tsconfig.build.json && bun scripts/build-browser.ts",
    "build-browser": "bun scripts/build-browser.ts",
    "check-generated": "bun run scripts/check-generated.ts",
    "format:check": "oxfmt --check .",
    "generate": "node scripts/hey-api-runner.mjs --file openapi-ts.config.ts",
    "lint": "oxlint .",
    "test": "bun test test/unit",
    "test-e2e": "playwright test --config test/playwright.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@orpc/contract": "2.0.0-beta.44",
    "@orpc/openapi": "2.0.0-beta.44",
    "@orpc/zod": "2.0.0-beta.44",
    "@types/bun": "1.4.4",
    "oxfmt": "0.74.0",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2",
    "typescript-legacy": "npm:typescript@6.0.3"
  },
  "packageManager": "bun@1.4.4"
}
