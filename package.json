{
  "name": "@orvelt/business",
  "version": "0.1.0",
  "description": "TypeScript SDK for the public Orvelt Business REST API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orveltinc/typescript-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/orveltinc/typescript-sdk/issues"
  },
  "homepage": "https://github.com/orveltinc/typescript-sdk#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi.json": "./openapi.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "bun run generate && bun run typecheck && bun run test && rm -rf dist && tsc --project tsconfig.build.json",
    "check-generated": "bun run scripts/check-generated.ts",
    "format:check": "oxfmt --check .",
    "generate": "node scripts/hey-api-runner.mjs --file openapi-ts.config.ts",
    "lint": "oxlint .",
    "test": "bun test test/unit/api.test.ts test/unit/config.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.4.3",
    "@pointsy/business-contract": "workspace:*"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@types/bun": "1.4.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.79.0",
    "typescript": "^7.0.2",
    "typescript-legacy": "npm:typescript@6.0.3"
  },
  "packageManager": "bun@1.4.0"
}
