{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noEmitOnError": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": ["bun"],
    "outDir": "../../.moon/cache/types/packages/business-sdk",
    "paths": {
      "@pointsy/business-contract": ["../business-contract/src/index.ts"],
      "@pointsy/business-contract/*": ["../business-contract/src/*"]
    }
  },
  "include": ["openapi-ts.config.ts", "scripts/check-generated.ts", "src/**/*", "test/**/*"],
  "exclude": ["dist", "node_modules"],
  "references": [
    {
      "path": "../business-contract"
    }
  ]
}
